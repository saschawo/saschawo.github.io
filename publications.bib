@article{hunlich_ids-goethe-studie_2018,
	series = {Deutsche {Sprache}},
	title = {Die {IDS}-{Goethe}-{Studie} in den {Integrationskursen}: {Kollektive} ­{Sprachbiografien}, erkennbare {Teilnehmergruppen} und sprachliche {Selbsteinschätzungen}},
	volume = {46},
	copyright = {All rights reserved},
	issn = {0340-9341},
	url = {https://nbn-resolving.org/urn:nbn:de:bsz:mh39-78852},
	abstract = {Der Beitrag widmet sich den Geflüchteten als Teil der deutschlernenden Teilnehmer/innen in den staatlich verordneten Integrationskursen (IKs). Unsere Erhebung unter 305 Geflüchteten aus Syrien und anderen Ländern legt ihren Schwerpunkt auf die sprachlichen Hintergründe. Dabei werden soziodemografische Daten mit Angaben zum Spracherwerb in Beziehung gesetzt und als kollektive Sprachbiografien dargestellt. Des Weiteren beschreiben wir sieben Teilnehmergruppen von Geflüchteten in den IKs, die sich vor allem auf Grund der Faktoren Alter, Bildungsgrad und Arbeitserfahrung unterscheiden, für die aber auch Merkmale im Hinblick auf Herkunft und Mehrsprachigkeit eine Rolle spielen. Ferner werden Angaben zur Sozialsituation in Deutschland mit Einschätzungen zum Deutscherwerb in Beziehung gesetzt. Ein Vergleich mit anderen Studien verdeutlicht die Verschiebungen in der Zusammensetzung des IK. Unser Beitrag kann als Anregung verstanden werden, die Passgenauigkeit im Sinne der Deutschlernenden zu überdenken.},
	language = {de},
	number = {3},
	publisher = {Erich Schmidt},
	author = {Hünlich, David and Wolfer, Sascha and Lang, Christian},
	year = {2018},
	note = {Edition: Zweitveröffentlichung
Place: Berlin},
	pages = {209 -- 244},
}

