@article{muller-spitzer_observing_2015,
	title = {Observing {Online} {Dictionary} {Users}: {Studies} {Using} {Wiktionary} {Log} {Files}},
	volume = {28},
	copyright = {All rights reserved},
	issn = {0950-3846, 1477-4577},
	shorttitle = {Observing {Online} {Dictionary} {Users}},
	url = {http://ijl.oxfordjournals.org/content/28/1/1},
	doi = {10.1093/ijl/ecu029},
	abstract = {We present studies using the 2013 log files from the German version of Wiktionary. We investigate several lexicographically relevant variables and their effect on look-up frequency: Corpus frequency of the headword seems to have a strong effect on the number of visits to a Wiktionary entry. We then consider the question of whether polysemic words are looked up more often than monosemic ones. Here, we also have to take into account that polysemic words are more frequent in most languages. Finally, we present a technique to investigate the time-course of look-up behaviour for specific entries. We exemplify the method by investigating influences of (temporary) social relevance of specific headwords.},
	language = {en},
	number = {1},
	urldate = {2015-04-02},
	journal = {International Journal of Lexicography},
	author = {Müller-Spitzer, Carolin and Wolfer, Sascha and Koplenig, Alexander},
	month = jan,
	year = {2015},
	pages = {1--26},
	file = {Full Text PDF:/Users/sascha/Zotero/storage/3TKNDUSE/Müller-Spitzer et al. - 2015 - Observing Online Dictionary Users Studies Using W.pdf:application/pdf;Snapshot:/Users/sascha/Zotero/storage/TWCKL34B/1.html:text/html},
}

