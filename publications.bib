@article{muller-spitzer_vernetzungsstrukturen_2015,
	title = {Vernetzungsstrukturen digitaler {Wörterbücher}. {Neue} {Ansätze} zur {Analyse} / {Cross}-linking structures of digital dictionaries. {New} approaches for analysis / {La} structure des liens croisés dans les dictionnaires électroniques},
	volume = {31},
	copyright = {All rights reserved},
	issn = {1865-9403},
	doi = {10.1515/lexi-2015-0009},
	abstract = {In this contribution, we present a novel approach for the analysis of cross-reference structures in digital dictionaries on the basis of the complete dictionary database. Using paradigmatic items in the German Wiktionary as an example, we show how analyses based on graph theory can be fruitfully applied in this context, e. g. to gain an overview of paradigmatic references as a whole or to detect closely connected groups of headwords. Furthermore, we connect information about cross-reference structures with corpus frequencies and log file statistics. In this way, we can answer questions such as the following ones: Are frequent words paradigmatically linked more closely than others? Are closely linked headwords or headwords that stand more solitary in the dictionary visited significantly more often?},
	number = {1},
	urldate = {2016-06-09},
	journal = {Lexicographica},
	author = {Müller-Spitzer, Carolin and Wolfer, Sascha},
	year = {2015},
	pages = {173--199},
	file = {Full Text PDF:/Users/sascha/Zotero/storage/2BVEUEMV/Müller-Spitzer und Wolfer - 2015 - Vernetzungsstrukturen digitaler Wörterbücher. Neue.pdf:application/pdf},
}

@article{wolfer_tracking_2020,
	title = {Tracking and analyzing recent developments in {German}-language online press in the face of the coronavirus crisis: {cOWIDplus} {Analysis} and {cOWIDplus} {Viewer}},
	volume = {25},
	copyright = {All rights reserved},
	doi = {https://doi.org/10.1075/ijcl.20078.wol},
	abstract = {The coronavirus pandemic may be the largest crisis the world has had to face since World War II. It does not come as a surprise that it is also having an impact on language as our primary communication tool. In this short paper, we present three inter-connected resources that are designed to cap- ture and illustrate these effects on a subset of the German language: An RSS corpus of German-language newsfeeds (with freely available untruncated frequency lists), a continuously updated HTML page tracking the diversity of the vocabulary in the RSS corpus and a Shiny web application that enables other researchers and the broader public to explore the corpus in terms of basic frequencies.},
	number = {3},
	journal = {International Journal of Corpus Linguistics},
	author = {Wolfer, Sascha and Koplenig, Alexander and Michaelis, Frank and Müller-Spitzer, Carolin},
	year = {2020},
	keywords = {corona},
	pages = {347--359},
}

@article{kosem_image_2018,
	title = {The {Image} of the {Monolingual} {Dictionary} {Across} {Europe}. {Results} of the {European} {Survey} of {Dictionary} use and {Culture}},
	volume = {32},
	copyright = {All rights reserved},
	issn = {0950-3846},
	url = {https://doi.org/10.1093/ijl/ecy022},
	doi = {10.1093/ijl/ecy022},
	abstract = {The article presents the results of a survey on dictionary use in Europe, focusing on general monolingual dictionaries. The survey is the broadest survey of dictionary use to date, covering close to 10,000 dictionary users (and non-users) in nearly thirty countries. Our survey covers varied user groups, going beyond the students and translators who have tended to dominate such studies thus far. The survey was delivered via an online survey platform, in language versions specific to each target country. It was completed by 9,562 respondents, over 300 respondents per country on average. The survey consisted of the general section, which was translated and presented to all participants, as well as country-specific sections for a subset of 11 countries, which were drafted by collaborators at the national level. The present report covers the general section.},
	number = {1},
	urldate = {2020-04-08},
	journal = {International Journal of Lexicography},
	author = {Kosem, Iztok and Lew, Robert and Müller-Spitzer, Carolin and Ribeiro Silveira, Maria and Wolfer, Sascha and Dorn, Amelie and Gurrutxaga, Antton and Ceberio, Klara and Etxeberria, Elixabete and Lefer, Marie-Aude and Geeraerts, Dirk and Štrkalj Despot, Kristina and Stojanov, Tomislav and Ljubešić, Nikola and Škrabal, Michal and Štěpánková, Barbora and Vodrážková, Veronika and Lorentzen, Henrik and Trap-Jensen, Lars and Kallas, Jelena and Tuulik, Maria and Koppel, Kristina and Langemets, Margit and Heinonen, Tarja and Thomas, Izabella and Margilitadze, Tinatin and Markantonatou, Stella and Giouli, Voula and Mulhall, Chris and Kernerman, Ilan and Ben-Moshe, Yifat and Sadan, Tsvi and Abel, Andrea and Nied Curcio, Martina and Tanturovska, Lidija and Nikovska, Biljana and Tiberius, Carole and Grønvik, Oddrun and Hovdenak, Marit and Berg-Olsen, Sturla and Karlsen, Knut E and Smith Ore, Christian-Emil and Biesaga, Monika and Zingano Kuhn, Tanara and Silvestre, Joao and Isabelle Tamba, Elena and Haja, Gabriela and Clim, Marius-Radu and Patrascu, Madalin-Ionel and Tasovac, Toma and Petrović, Snežana and Arhar Holdt, Špela and Valcarcel Riveiro, Carlos and Domínguez Vázquez, María José and Volodina, Elena and Pilán, Ildikó and Sköldberg, Emma and Holmer, Louise and Nesi, Hilary},
	month = dec,
