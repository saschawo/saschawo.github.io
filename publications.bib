@incollection{wolfer_visualisierung_2018,
	address = {Heidelberg},
	title = {Visualisierung sprachlicher {Daten} mit {R}},
	copyright = {All rights reserved},
	isbn = {978-3-946054-75-7},
	doi = {10.17885/heiup.345.474},
	abstract = {Die ansprechende und geeignete Visualisierung linguistischer Daten gewinnt analog zum steigenden Einfluss quantitativer Methoden in der Linguistik immer mehr an Bedeutung. R ist eine flexible und freie Entwicklungsumgebung zur Umsetzung von statistischen Analysen, die zahlreiche Optionen zur Datenvisualisierung bereithält und sehr gut für große Datensätze geeignet ist. Statistische Analysen und Visualisierungen von Daten werden auf diese Weise in einer Umgebung verzahnt. Durch die zahlreichen Zusatzpakete stehen auch weiterhin zeitgemäße Methoden zur Verfügung, um (linguistische) Daten zu analysieren und darzustellen. 
Der Beitrag vermittelt einen stark anwendungsorientierten Einstieg in das Programm und legt mithilfe von vielen praktischen Übungen und Anwendungsbeispielen die Grundlagen für ein eigenständiges Weiterentwickeln der individuellen Fähigkeiten im Umgang mit der Software. Neben einer kurzen, eher theoretisch angelegten Einleitung zu explorativen und explanatorischen Visualisierungsstrategien von Daten werden verschiedene Pakete vorgestellt, die für die Visualisierung in R benutzt werden können.},
	booktitle = {Visualisierung sprachlicher {Daten}. {Visual} {Linguistics} - {Praxis} - {Tools}},
	publisher = {Heidelberg University Publishing},
	author = {Wolfer, Sascha and Hansen-Morath, Sandra},
	editor = {Bubenhofer, Noah and Kupietz, Marc},
	year = {2018},
	keywords = {Datenanalyse, Linguistische Informationswissenschaft, R, Sprachstatistik, Visual Linguistics, Visualisierung},
	pages = {227--256},
}

